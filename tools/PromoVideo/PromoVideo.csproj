<Project Sdk="Microsoft.NET.Sdk">

  <!-- Makes the Mini CloClo promo video, offline: scenes drawn with WPF (the
       app's own avatar), narration from a Windows voice, encoded to MP4 by
       Windows (Windows.Media.Editing). Not part of the app or its install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PromoVideo</RootNamespace>
    <!-- The app project is a self-contained win-x64 exe; a project that
         references it has to match. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MiniCloClo.csproj" />
  </ItemGroup>

</Project>
