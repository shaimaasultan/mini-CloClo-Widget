<Window x:Class="MiniCloClo.CustomRemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Custom reminders" Width="560" Height="560" FontSize="15"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinWidth="460" MinHeight="420"
        ShowInTaskbar="True" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Target="{Binding ElementName=ReminderList}" Padding="0" Margin="0,0,0,10">
            <AccessText TextWrapping="Wrap" Text="Your _reminders. Each one is said out loud, and shown, every so often during its active hours. The next one is at the top." />
        </Label>
        <ListBox x:Name="ReminderList" HorizontalContentAlignment="Stretch" Grid.IsSharedSizeScope="True" Grid.Row="1" SelectionChanged="ReminderList_SelectionChanged"
                 AutomationProperties.Name="Reminders" MouseDoubleClick="EditButton_Click">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Next" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NextTime}" Margin="0,0,16,0" FontWeight="SemiBold" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ReminderDetails" Grid.Row="2" Margin="2,8,2,10" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        <StackPanel Grid.Row="3">
            <WrapPanel HorizontalAlignment="Left">
                <Button x:Name="AddButton" Content="_Add…" MinWidth="80" Padding="10,5" Margin="0,0,6,6" Click="AddButton_Click" />
                <Button x:Name="EditButton" Content="_Edit…" MinWidth="80" Padding="10,5" Margin="0,0,6,6" Click="EditButton_Click" IsEnabled="False" />
                <Button x:Name="TestButton" Content="Say it _now" MinWidth="80" Padding="10,5" Margin="0,0,6,6" Click="TestButton_Click" IsEnabled="False" />
                <Button x:Name="ToggleButton" Content="_Turn off" MinWidth="80" Padding="10,5" Margin="0,0,6,6" Click="ToggleButton_Click" IsEnabled="False" />
                <Button x:Name="RemoveButton" Content="Re_move" MinWidth="80" Padding="10,5" Margin="0,0,6,6" Click="RemoveButton_Click" IsEnabled="False" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" MinWidth="80" Padding="10,5" Margin="0,0,6,0" IsCancel="True" />
                <Button Content="_Save reminders" MinWidth="120" Padding="10,5" IsDefault="True" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
