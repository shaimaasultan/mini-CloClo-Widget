<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>src\config\app.manifest</ApplicationManifest>
    <AssemblyName>MiniCloClo</AssemblyName>
    <RootNamespace>MiniCloClo</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mini CloClo</Product>
    <Description>An offline talking clock widget with voice commands, reminders, azan and Quran memorization.</Description>
    <!-- Program.Main, not WPF's generated one: it takes the single-instance
         lock and hardens DLL loading before WPF starts. -->
    <StartupObject>MiniCloClo.Program</StartupObject>
    <!-- Ignore DOTNET_STARTUP_HOOKS: that variable otherwise makes .NET run
         any DLL's code before Main. -->
    <StartupHookSupport>false</StartupHookSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Mini CloClo is published as a plain folder (scripts\install.ps1):
         nothing is unpacked to %TEMP% at start, so there is no extraction
         folder for another program to plant a DLL in. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- tools\ holds the pull tools, the calendar script and the promo video maker (a separate project), not app code. -->
    <!-- The bundled Whisper model (#36): its file in Assets\Models and its
         SHA-256, checked here at build time and again by PlaybackModelStore. -->
    <SpeechModelFile>ggml-large-v3-turbo-q5_0.bin</SpeechModelFile>
    <SpeechModelSha256>394221709CD5AD1F40C46E6031CA61BCE88931E6E088C188294C6D5A55FFA7E2</SpeechModelSha256>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- The CPU runtime is copied as four explicit win-x64 files below. Its
         default build target copies other architectures into subdirectories. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
    <!-- The CUDA build of the same runtime (#36), for NVIDIA graphics cards:
         copied, checked, into a cuda folder below; the CPU one stays the
         fallback. -->
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>

  <!-- The Quran text, surah names and Saheeh International's English meaning,
       from tanzil.net, unchanged and compiled into the exe, so nothing can
       swap the text on disk and nothing is fetched. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Quran\quran-uthmani.txt" LogicalName="MiniCloClo.Quran.quran-uthmani.txt" />
    <EmbeddedResource Include="Assets\Quran\quran-data.xml" LogicalName="MiniCloClo.Quran.quran-data.xml" />
    <EmbeddedResource Include="Assets\Quran\en.sahih.txt" LogicalName="MiniCloClo.Quran.en.sahih.txt" />
  </ItemGroup>

  <!-- The speech model is inert data beside the exe; PlaybackModelStore
       checks its size and SHA-256 before Whisper gets it. -->
  <ItemGroup>
    <Content Include="Assets\Models\$(SpeechModelFile)" Link="$(SpeechModelFile)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\Recitations\**" />
    <!-- The built-in azan recordings, in an Azan folder beside the exe
         (AzanLibrary). Any MP3 or WAV put in Assets\Azan is included. -->
    <Content Include="Assets\Azan\*.mp3;Assets\Azan\*.wav" Link="Azan\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Pull tools (#35): tools\pull\<name>\tool.json and run.ps1, installed
       in tools\pull beside the exe. The dates tool runs the calendar script
       from tools\questions-and-answers\, copied in beside it. -->
  <ItemGroup>
    <Content Include="tools\pull\**\*" Link="tools\pull\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\questions-and-answers\Get-CalendarTopics.ps1" Link="tools\pull\dates\Get-CalendarTopics.ps1"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyBundledWhisperModel" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Models\$(SpeechModelFile)')"
           Text="The Whisper speech model Assets\Models\$(SpeechModelFile) is missing. Run scripts\Get-SpeechFiles.cmd first." />
    <GetFileHash Files="$(MSBuildProjectDirectory)\Assets\Models\$(SpeechModelFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BundledModelHash" />
    </GetFileHash>
    <Error Condition="'%(_BundledModelHash.FileHash)' != '$(SpeechModelSha256)'"
           Text="The Whisper speech model is incomplete or altered." />
  </Target>

  <!-- The four Whisper CPU DLLs, checked byte for byte against the pinned
       Whisper.net.Runtime 1.9.1 package, then copied beside the exe. -->
  <ItemGroup>
    <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-base-whisper.dll" ExpectedHash="E6C362421B6D5A5C1B52341F88D3D72764DE29F05141748CC3FAAD2F6348063F" />
    <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-cpu-whisper.dll" ExpectedHash="480A23AFC6DEEA301C5CDA66CF462FA2F2EB7FF9BCA63B8F4F933A0E8DC5D4DD" />
    <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-whisper.dll" ExpectedHash="2E0AC238C2BC178A5C1F09B3BDE2421904B191BCE1CC1C13DC64309CA3B9CB36" />
    <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\whisper.dll" ExpectedHash="07EC2FAC4946005BA7380F2C2E9CCFA3AD23007592D074AA698ED5DF6BFB4938" />
    <Content Include="@(_WhisperSource)" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyWhisperRuntime" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(_WhisperSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WhisperSourceHash" />
    </GetFileHash>
    <Error Condition="'%(_WhisperSourceHash.FileHash)' != '%(_WhisperSourceHash.ExpectedHash)'"
           Text="Whisper CPU runtime differs from the pinned 1.9.1 package: %(_WhisperSourceHash.Identity)" />
  </Target>

  <!-- The CUDA runtime (#36): the same Whisper DLLs built for NVIDIA cards,
       from the pinned Whisper.net.Runtime.Cuda.Windows 1.9.1 package, and
       NVIDIA's cuBLAS 13.8.0.4 (fetched by scripts\Get-SpeechFiles.ps1), all
       checked byte for byte and copied into a cuda folder beside the exe.
       Without cuBLAS (Get-SpeechFiles -NoCuda) none of it is included and
       the model runs on the processor. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Assets\Cuda\cublas64_13.dll')">
    <_CudaSource Include="$(PkgWhisper_net_Runtime_Cuda_Windows)\build\win-x64\ggml-base-whisper.dll" ExpectedHash="4AEE9DDC683134AF3F142C6EB084B4CABBBB4A508A8A4A7E1C3EDB7FB4C2C015" />
    <_CudaSource Include="$(PkgWhisper_net_Runtime_Cuda_Windows)\build\win-x64\ggml-cpu-whisper.dll" ExpectedHash="65B8B0524C8C5CFF3FABD6312C38A4B03A5FEC5CABCEDC4C1FB7E761639AA027" />
    <_CudaSource Include="$(PkgWhisper_net_Runtime_Cuda_Windows)\build\win-x64\ggml-cuda-whisper.dll" ExpectedHash="ED197873D29FDDD308CB79276288DCF313B64C58894A1AC5DB6C3A01A2A87443" />
    <_CudaSource Include="$(PkgWhisper_net_Runtime_Cuda_Windows)\build\win-x64\ggml-whisper.dll" ExpectedHash="C16BD1FE1D04AD708C407B11EE38F1EE44CAA7206E8FFDDD4B34FB2F4192781A" />
    <_CudaSource Include="$(PkgWhisper_net_Runtime_Cuda_Windows)\build\win-x64\whisper.dll" ExpectedHash="EF73371BA9D1EF0AB94316907CD50B9CBEC5DD0829B89BA6F3DC19871C32F40A" />
    <_CudaSource Include="Assets\Cuda\cublas64_13.dll" ExpectedHash="60BBBA8868290311E9C1657B2193DDEC667744EB555FF843F87ACB7C039F9EFA" />
    <_CudaSource Include="Assets\Cuda\cublasLt64_13.dll" ExpectedHash="CAD63434448E7141629E240EA093AD596A7EF6A0F67B468BA9BC1DF6E1EEEE33" />
    <Content Include="@(_CudaSource)" Link="cuda\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyCudaRuntime" BeforeTargets="CoreCompile" Condition="'@(_CudaSource)' != ''">
    <GetFileHash Files="@(_CudaSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CudaSourceHash" />
    </GetFileHash>
    <Error Condition="'%(_CudaSourceHash.FileHash)' != '%(_CudaSourceHash.ExpectedHash)'"
           Text="CUDA runtime file differs from its pinned version: %(_CudaSourceHash.Identity). Run scripts\Get-SpeechFiles.ps1 again." />
  </Target>

  <!-- msquic.dll is .NET's QUIC (HTTP/3) networking engine. Nothing in Mini
       CloClo uses QUIC, so it isn't shipped. -->
  <Target Name="DropUnusedNetworkingRuntime" AfterTargets="Publish">
    <Delete Files="$(PublishDir)msquic.dll" />
  </Target>

  <!-- Mini CloClo never goes online: the build fails if any source file
       creates an HTTP client, socket or web request. -->
  <Target Name="CheckNoNetwork" BeforeTargets="CoreCompile">
    <PropertyGroup><_NetworkScanList>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)network-scan.txt</_NetworkScanList></PropertyGroup>
    <WriteLinesToFile File="$(_NetworkScanList)" Lines="@(Compile->'%(FullPath)')" Overwrite="true" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\check-no-network.ps1&quot; -ListFile &quot;$(_NetworkScanList)&quot;" />
  </Target>

</Project>
